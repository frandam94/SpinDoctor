# Copy this file to `.env` and fill in the values. `.env` is excluded from git.
# None of the values below are real: they are placeholders only.

# Roboflow API key.
# Needed ONLY if you download the dataset through the Roboflow SDK rather than
# by hand. The workflow documented in training/README.md is manual (you label
# and export from the Roboflow UI, then unpack into data/basketball_coco/), so
# under normal use this variable is not needed and no script reads it.
ROBOFLOW_API_KEY=
